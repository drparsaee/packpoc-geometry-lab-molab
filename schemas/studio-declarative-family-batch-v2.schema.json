{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packpoc.com/schemas/geometry-lab/studio-declarative-family-batch-v2",
  "title": "Private metric Studio DeclarativeFamilyCompiler to DieIR candidate batch",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "generator", "unit", "familyCompiler", "approval", "models", "variants"],
  "properties": {
    "schemaVersion": {"const": "packpoc.geometry-lab.dieir-batch/v2"},
    "generator": {"const": "StudioParametricFamilyCompiler.compile->StudioDieIR.compile"},
    "unit": {"const": "mm"},
    "familyCompiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "compilerModuleSHA256", "definitionModuleSHA256", "sourceOnlyReview", "physical3DFoldApproved"],
      "properties": {
        "familyId": {"type": "string", "minLength": 1},
        "compilerModuleSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "definitionModuleSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceOnlyReview": {"const": true},
        "physical3DFoldApproved": {"const": false}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studioActivationPermitted", "manufacturingApproved", "sourceCADIndependentlyVerifiedByThisBatch", "physical3DVerified"],
      "properties": {
        "studioActivationPermitted": {"const": false},
        "manufacturingApproved": {"const": false},
        "sourceCADIndependentlyVerifiedByThisBatch": {"const": false},
        "physical3DVerified": {"const": false}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8000,
      "items": {
        "type": "object",
        "required": ["id", "familyId"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "familyId": {"type": "string", "minLength": 1}
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["sourceId", "variantId", "sourceSHA256", "sourceArtifactSHA256", "sourceHashScope", "sourceCoordinateUnit", "inputParameters", "dieIR", "engineVersion", "compilerProvenance", "candidateOnly", "manufacturingApproved", "independentCADWitnessVerifiedInThisExport"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "variantId": {"type": "string", "minLength": 1},
          "sourceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceArtifactSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceHashScope": {"type": "string"},
          "sourceCoordinateUnit": {"const": "mm"},
          "candidateOnly": {"const": true},
          "manufacturingApproved": {"const": false},
          "independentCADWitnessVerifiedInThisExport": {"const": false},
          "engineVersion": {
            "type": "object",
            "required": ["compilerModuleSHA256", "definitionModuleSHA256"],
            "properties": {
              "compilerModuleSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "definitionModuleSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "compilerProvenance": {
            "type": "object",
            "required": ["familyId", "sourceSemantics", "caseRole"],
            "properties": {
              "familyId": {"type": "string", "minLength": 1},
              "sourceSemantics": {"const": "audited-declarative-rules-candidate-only"},
              "caseRole": {"type": "string", "minLength": 1}
            }
          },
          "inputParameters": {
            "type": "object",
            "required": ["L", "W", "D", "DX", "material"],
            "properties": {
              "L": {"type": "number"},
              "W": {"type": "number"},
              "D": {"type": "number"},
              "DX": {"const": 0},
              "fefco": {"type": ["object", "array"]},
              "material": {"type": "object"}
            }
          },
          "dieIR": {
            "type": "object",
            "required": ["schemaVersion", "templateId", "unit", "reviewOnly", "entities"],
            "properties": {
              "schemaVersion": {"const": 1},
              "templateId": {"type": "string"},
              "unit": {"const": "mm"},
              "reviewOnly": {"const": true},
              "panelTopology": {"type": ["object", "null"]},
              "entities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "items": {
                  "type": "object",
                  "required": ["id", "sourceIndex", "operation", "nativeEntityType", "pointsMm"],
                  "properties": {
                    "id": {"type": "string"},
                    "sourceIndex": {"type": "integer", "minimum": 0},
                    "operation": {"enum": ["cut", "crease", "perf", "trim", "adhesive_region", "varnish_exclusion", "partial_cut", "reverse_partial_cut", "perforation", "score"]},
                    "nativeEntityType": {"enum": ["LINE", "ARC", "POLYLINE"]},
                    "analyticArc": {"type": ["object", "null"]},
                    "pointsMm": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "required": ["x", "y"],
                        "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
